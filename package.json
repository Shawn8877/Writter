{
  "name": "novelai-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:db": "node scripts/test-database.mjs",
    "test:repository": "node scripts/test-repository.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:browser:cloud": "node scripts/testing/browser-cloud.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:ai": "node --import ./scripts/testing/register-server.mjs scripts/test-ai.mjs",
    "test:chapters": "node --import ./scripts/testing/register-server.mjs scripts/test-chapters.mjs",
    "test:memory": "node --import ./scripts/testing/register-server.mjs scripts/test-chapter-memory.mjs",
    "test:runs": "node --import ./scripts/testing/register-server.mjs scripts/test-generation-runs.mjs",
    "test:reviews": "node --import ./scripts/testing/register-server.mjs scripts/test-chapter-review.mjs",
    "test:health": "node --import ./scripts/testing/register-server.mjs scripts/test-novel-health.mjs",
    "test:stress": "node --import ./scripts/testing/register-server.mjs scripts/testing/long-novel-stress.mjs",
    "test:stress:report": "node --import ./scripts/testing/register-server.mjs scripts/testing/analyze-long-novel.mjs",
    "test:browser:reviews": "node scripts/testing/browser-chapter-review.mjs",
    "test:browser:review-critical": "node --import ./scripts/testing/register-server.mjs scripts/testing/browser-review-critical.mjs",
    "test:browser:runs": "node scripts/testing/browser-generation-runs.mjs",
    "test:browser:memory": "node --import ./scripts/testing/register-server.mjs scripts/testing/browser-chapter-memory.mjs",
    "test:browser:chapters": "node scripts/testing/browser-chapters.mjs",
    "test:browser:ai": "node scripts/testing/browser-ai-builder.mjs",
    "test:browser:ai:cloud": "node --import ./scripts/testing/register-server.mjs scripts/testing/browser-ai-cloud.mjs",
    "test:ai:smoke": "node --import ./scripts/testing/register-server.mjs scripts/testing/browser-ai-cloud.mjs --real-ai"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "openai": "^7.30.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.2.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.2.1"
  }
}
