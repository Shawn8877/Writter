# Copy to .env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The second variable accepts the legacy anon key or a publishable key.
# NEVER put a service_role JWT or sb_secret_ key in NEXT_PUBLIC_ variables.
# Phase 2 uses user sessions + RLS and requires no service-role key.
# OpenAI is not connected and no OpenAI key is needed.
